{
   "name": "developers_contacts_backend",
   "version": "1.0.0",
   "description": "",
   "main": "index.js",
   "scripts": {
      "test": "echo \"Error: no test specified\" && exit 1",
      "start": "ts-node-dev --respawn --transpile-only --exit-child src/app.ts",
      "build": "tsc -p .",
      "typeorm": "typeorm-ts-node-commonjs",
      "typeorm:ds": "typeorm-ts-node-commonjs -d ./src/utils/data-source.ts",
      "migrate": "rm -rf build && npm run build && npm run typeorm:ds migration:generate src/migrations/added-entity",
      "db:push": "rm -rf build && npm run build && npm run typeorm:ds migration:run"
   },
   "repository": {
      "type": "git",
      "url": "git+https://github.com/bodeacornelia/developers_contacts_backend.git"
   },
   "keywords": [],
   "author": "",
   "license": "ISC",
   "bugs": {
      "url": "https://github.com/bodeacornelia/developers_contacts_backend/issues"
   },
   "homepage": "https://github.com/bodeacornelia/developers_contacts_backend#readme",
   "devDependencies": {
      "@types/config": "^3.3.0",
      "@types/cookie-parser": "^1.4.3",
      "@types/cors": "^2.8.13",
      "@types/express": "^4.17.17",
      "@types/morgan": "^1.9.4",
      "@types/node": "^16.11.10",
      "i": "^0.3.7",
      "npm": "^9.6.2",
      "ts-node": "10.7.0",
      "ts-node-dev": "^2.0.0",
      "typescript": "4.5.2"
   },
   "dependencies": {
      "config": "^3.3.9",
      "cookie-parser": "^1.4.6",
      "cors": "^2.8.5",
      "dotenv": "^16.0.3",
      "envalid": "^7.3.1",
      "express": "^4.18.2",
      "morgan": "^1.10.0",
      "pg": "^8.4.0",
      "redis": "^4.6.5",
      "reflect-metadata": "^0.1.13",
      "typeorm": "0.3.12",
      "zod": "^3.21.4"
   },
   "typeorm": {
      "entities": [
        "src/entities/**/*.ts"
      ],
      "migrations": [
        "src/migrations/**/*.ts"
      ],
      "cli": {
        "entitiesDir": "src/entities",
        "migrationsDir": "src/migrations",
        "subscribersDir": "src/subscribers"
      },
      "dataSource": "src/utils/data-source.ts"
  }
}
